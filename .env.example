# Copy to .env.local for local use, or set in your host's environment.
# Nothing here is required — the site builds and deploys without it.

# The canonical origin for absolute URLs: canonical links, Open Graph and
# Twitter URLs, sitemap.xml, robots.txt and the JSON-LD `url`.
#
# Leave unset and the origin is resolved for you:
#   • on a Vercel production build, from VERCEL_PROJECT_PRODUCTION_URL
#   • otherwise absolute URLs are omitted rather than invented
#
# Set it to pin the final domain without editing source.
# NEXT_PUBLIC_SITE_URL=https://aarizkhan.dev
